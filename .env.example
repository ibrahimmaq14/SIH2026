# ── Oil Spill Detection backend configuration ────────────────────────────────
# Copy to .env (backend) and adjust. NEVER commit real secrets.
# All variables are OPTIONAL — sensible defaults are compiled in and the
# system runs fully offline in demo mode without any keys.

# Data locations (relative paths resolve against the repository root)
DATA_DIR=Oil-Spill-Detection-in-Marine-Environments-Using-AIS-and-Satellite-Data
# AIS_CSV=Oil-Spill-Detection-in-Marine-Environments-Using-AIS-and-Satellite-Data/AIS Dataset
# SAR_DIR=Oil-Spill-Detection-in-Marine-Environments-Using-AIS-and-Satellite-Data/SAR Image Dataset

# Model artifacts
MODELS_DIR=backend/models

# Run persistence (JSON files)
RUNS_DIR=backend/data/runs

# Demo mode: true = always use the labelled synthetic environmental provider.
# false = try the REAL Open-Meteo marine/wind API first (no key needed), fall
# back to synthetic when offline.
DEMO_MODE=true

# Demo scenario anchor (inside the real AIS dataset coverage area).
# The SAR dataset images are NOT georeferenced; the pipeline labels this
# anchor as SYNTHETIC unless you pass real acquisition coordinates.
DEMO_SPILL_LAT=28.52
DEMO_SPILL_LON=-94.95
DEMO_OBSERVATION_TIME=2021-02-01T12:00:00Z

# Environmental providers
# OPEN_METEOMARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
ENV_TIMEOUT_SECONDS=6

# Drift model
DEFAULT_WINDAGE=0.03
DEFAULT_TIMESTEP_MIN=30
DEFAULT_HINDCAST_HOURS=48
DEFAULT_FORECAST_HOURS=48
UNCERTAINTY_GROWTH_RATE=0.15
MONTE_CARLO_MEMBERS=40

# AIS search & filtering
AIS_SEARCH_RADIUS_KM=15
AIS_TIME_WINDOW_HOURS=12
MIN_AIS_OBSERVATIONS=3
MAX_SOG_KNOTS=60

# Attribution scoring weights (should sum to ~1.0)
SCORE_WEIGHT_SPATIAL=0.30
SCORE_WEIGHT_TEMPORAL=0.25
SCORE_WEIGHT_TRAJECTORY=0.20
SCORE_WEIGHT_BEHAVIOUR=0.15
SCORE_WEIGHT_DATA_QUALITY=0.10

# Uploads
MAX_UPLOAD_BYTES=15728640
